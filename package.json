{
  "name": "another-redis-desktop-manager",
  "version": "1.1.1",
  "description": "A faster, better and more stable redis desktop manager, compatible with Linux, windows, mac",
  "author": "qii404",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "npm run dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "electron": "node scripts/electron-dev.js",
    "lint": "eslint --ext js,vue src --fix",
    "lint:init": "eslint --init",
    "asar": "asar pack dist dist/app.asar --unpack-dir \"{app.asar,build-apps,app.asar.unpacked}\"",
    "pack:prepare": "npm run build && node build/copy-pack-electron.js",
    "pack:win": "electron-builder --project=dist -w -p never --config.win.signAndEditExecutable=false",
    "pack:win32": "electron-builder --project=dist -w --ia32 -p never --config.win.signAndEditExecutable=false",
    "pack:mac": "electron-builder --project=dist -m -p never",
    "pack:mas": "CSC_IDENTITY_AUTO_DISCOVERY=false npm run pack:mac",
    "pack:linux": "electron-builder --project=dist -l -p never",
    "pack:win:publish": "electron-builder --project=dist -w -p always --config.win.signAndEditExecutable=false",
    "pack:mac:publish": "electron-builder --project=dist -m -p always",
    "pack:macm1:publish": "electron-builder --project=dist -m --arm64 -p always -c.artifactName='${productName} M1 ${arch} ${version}.${ext}'",
    "pack:linux:publish": "electron-builder --project=dist -l -p always",
    "et": "et -m",
    "sign": "cd pack/mas; bash sign.sh"
  },
  "dependencies": {
    "@qii404/json-bigint": "^1.0.0",
    "@qii404/redis-splitargs": "^1.0.1",
    "algo-msgpack-with-bigint": "^2.1.1",
    "electron-updater": "^6.8.3",
    "element-plus": "^2.13.6",
    "font-awesome": "^4.7.0",
    "getopts": "^2.3.0",
    "ioredis": "^5.3.2",
    "java-object-serialization": "^0.1.1",
    "keymaster": "^1.6.2",
    "mitt": "^3.0.1",
    "monaco-editor": "^0.55.1",
    "node-version-compare": "^1.0.3",
    "php-serialize": "^4.0.2",
    "pickleparser": "^0.2.1",
    "protobufjs": "^6.11.2",
    "rawproto": "^0.7.6",
    "sortablejs": "^1.14.0",
    "tunnel-ssh": "^5.1.2",
    "vue": "^3.5.31",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "^2.0.0-beta.10",
    "vxe-table": "^4.18.9"
  },
  "devDependencies": {
    "@electron/notarize": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/compiler-sfc": "^3.5.31",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^7.0.3",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "font-list": "^1.4.5",
    "jsdom": "^29.0.1",
    "vite": "^7.0.0",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">= 18.0.0",
    "npm": ">= 9.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ]
}
